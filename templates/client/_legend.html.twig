{#
 # The legend the 2004 board carried under its lists (viewforum_body.tpl): one
 # entry per state a folder badge can take, drawn with the very art and the
 # very words the rows above it use. Variables:
 #
 #   scope   'topic' (a topic list) | 'board' (the board list) - the same five
 #           badges read differently on a board row, so the words differ
 #
 # phpBB listed its states twice, "new messages" and "no new messages". So does
 # this one, read as the site draws them: the sleeping "zzz" face is a board or
 # topic with no message for forum.active_hours, the talking one (speech
 # bubble) one with a recent message - activity, not "unread": base-bundle
 # keeps no per-member read marker. The announcement and the post-it have no
 # awake variant in the art. ForumTwigExtension::topicFolder()/boardFolder()
 # pick the badge the rows show; the states listed here are the same ones.
 #}
{% set scope = scope|default('topic') %}
{% set states = ['default', 'new', 'hot', 'new_hot', 'lock', 'new_lock', 'announce'] %}
{% if 'topic' == scope %}{% set states = states|merge(['sticky']) %}{% endif %}

{#
 # Styled here rather than in forum.css: the block is small, self-contained,
 # and belongs with the markup it describes.
 #}
<style>
/*
 * A grid, not a wrapping line: every entry the same width, so the words line up down the columns
 * whatever the badge; each badge in a box of its own fixed size (the "active" ones carry a speech
 * bubble and are twice as wide, which pushed their words sideways); and the note about "active" on a
 * line of its own across the whole box, rather than pushed to the right end of whatever line it
 * happened to fall on.
 */
.forum-legend { display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); align-items: center; gap: .45rem 1rem; margin: .75rem 0 0; padding: .7rem 1rem .6rem; list-style: none; background: #fff; border: 1px solid var(--forum-line); border-radius: var(--forum-radius); font-size: 13px; color: var(--forum-muted); }
.forum-legend-item { display: flex; align-items: center; gap: .5rem; min-width: 0; }
.forum-legend-item > span:last-child { overflow-wrap: anywhere; line-height: 1.25; }
.forum-legend-badge { flex: none; display: inline-flex; align-items: center; justify-content: flex-start; width: 38px; height: 26px; }
.forum-legend-badge .forum-folder { width: auto; height: 24px; max-width: 38px; object-fit: contain; }
.forum-legend-note { grid-column: 1 / -1; margin-top: .15rem; padding-top: .45rem; border-top: 1px dashed var(--forum-line); font-size: 12px; font-style: italic; }
</style>

<ul class="forum-legend" aria-label="{{ '@forum.legend.label'|trans }}">
    {% for state in states %}
        <li class="forum-legend-item forum-legend-{{ state }}">
            <span class="forum-legend-badge">{% include '@Forum/client/_folder.html.twig' with {state: state, size: 24} only %}</span>
            <span>{{ ('@forum.legend.' ~ scope ~ '.' ~ state)|trans }}</span>
        </li>
    {% endfor %}
    <li class="forum-legend-note">{{ '@forum.legend.active_note'|trans({hours: forum_active_hours()}) }}</li>
</ul>
