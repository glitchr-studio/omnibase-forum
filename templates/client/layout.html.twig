{#
 # The forum's chrome, inside the site's own layout: a title band, the
 # breadcrumb, the search box, then the page in two columns - the page's body,
 # and the forum's boxes beside it. Every forum page extends this.
 #
 # The application decides what "layout1.html.twig" is; the forum only asks
 # for its `content` block, the way base-bundle's own client templates do.
 # The boxes are the forum's own right-hand column (`forum_side`), so they line
 # up with the first block of the page rather than with the site's aside.
 #}
{% extends 'layout1.html.twig' %}

{% block title %}{{ block('forum_title') is defined ? block('forum_title') : '@forum.index.title'|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('bundles/forum/css/forum.css') }}">
{% endblock %}

{% block content %}
<div class="forum">
    {% block forum_header %}
    <header class="forum-header">
        {# The application supplies the painted banner (see _banner.html.twig); this is the text fallback. #}
        {% block forum_banner %}{% include '@Forum/client/_banner.html.twig' ignore missing %}{% endblock %}

        {# A site with a breadcrumb of its own empties this block, so the trail is not drawn twice. #}
        {% block forum_breadcrumb %}
        <nav class="forum-crumbs" aria-label="{{ '@forum.crumbs'|trans }}">
            <a href="{{ path('forum_index') }}"><i class="fa-solid fa-comments"></i> {{ '@forum.index.title'|trans }}</a>
            {% block forum_crumbs %}{% endblock %}
        </nav>
        {% endblock %}

        {# A topic's two styles - see TopicController::STYLES: the messages as cards, or the 2005 box. #}
        {% if topic_style is defined and topic is defined %}
        {% set page_param = posts is defined and posts.page > 1 ? posts.page : null %}
        {# A POST that remembers the choice (ForumController::Display) and comes back here: nothing in the address. #}
        <form class="forum-views" role="group" aria-label="{{ '@forum.style.label'|trans }}" method="post" action="{{ path('forum_display') }}">
            <input type="hidden" name="back" value="{{ app.request.requestUri }}">
            <button type="submit" name="style" value="retro" class="forum-view{{ topic_style == 'retro' ? ' is-active' }}"{{ topic_style == 'retro' ? ' aria-current="page"' }}><i class="fa-solid fa-clock-rotate-left"></i> {{ '@forum.style.retro'|trans }}</button>
            <button type="submit" name="style" value="cards" class="forum-view{{ topic_style == 'cards' ? ' is-active' }}"{{ topic_style == 'cards' ? ' aria-current="page"' }}><i class="fa-regular fa-clone"></i> {{ '@forum.style.cartes'|trans }}</button>
        </form>
        {% endif %}

        {# The index's views - see ForumController::VIEWS. Only where there is a view to switch. #}
        {% if view is defined %}
        <form class="forum-views" role="group" aria-label="{{ '@forum.view.label'|trans }}" method="post" action="{{ path('forum_display') }}">
            <input type="hidden" name="back" value="{{ path('forum_index') }}">
            <button type="submit" name="view" value="classic" class="forum-view{{ view == 'classic' ? ' is-active' }}"{{ view == 'classic' ? ' aria-current="page"' }}><i class="fa-solid fa-table-list"></i> {{ '@forum.view.classique'|trans }}</button>
            <button type="submit" name="view" value="feed" class="forum-view{{ view == 'feed' ? ' is-active' }}"{{ view == 'feed' ? ' aria-current="page"' }}><i class="fa-solid fa-stream"></i> {{ '@forum.view.fil'|trans }}</button>
        </form>
        {% endif %}

        <form class="forum-search" action="{{ path('forum_search') }}" method="get" role="search">
            <input type="search" name="q" value="{{ term|default('') }}" minlength="3" placeholder="{{ '@forum.search.placeholder'|trans }}" aria-label="{{ '@forum.search.placeholder'|trans }}">
            <button type="submit" aria-label="{{ '@forum.search.go'|trans }}"><i class="fa-solid fa-magnifying-glass"></i></button>
        </form>
    </header>
    {% endblock %}

    {# A site that shows its messages elsewhere (under its own breadcrumb) empties this block. #}
    {% block forum_flashes %}{% include 'flashbag.html.twig' ignore missing %}{% endblock %}

    {#
     # The page's lead, across both columns: what a page wants read before it,
     # above the column that follows the reading. A topic in the 2005 style
     # puts its title there - drawn bare, it is not a card the side column can
     # line up with, and the column started level with the title while the
     # messages began well under it (topic/show.html.twig).
     #}
    {% block forum_lead %}{% endblock %}

    {#
     # The page, then the boxes beside it, both starting on the same line. A
     # page adds to the column with {{ parent() }} in `forum_side` (the topic's
     # timeline does); nothing above it clips, so a child may be sticky. A page
     # that empties the block - one that shelves its boxes under itself, as the
     # feed does - gets no column at all and the whole width (forum.css).
     #}
    <div class="forum-page">
        <div class="forum-main">{% block forum_body %}{% endblock %}</div>
        <aside class="forum-side">
            {% block forum_side %}
                {% include '@Forum/client/_aside.html.twig' with {tags: tags|default([])} %}
            {% endblock %}
        </aside>
    </div>

    {# Under the page, for a site that wants something there; empty by default. #}
    {% block forum_footer %}{% endblock %}
</div>
{% endblock %}
