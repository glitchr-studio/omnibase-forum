{#
 # The forum's chrome, inside the site's own layout: a title band, the
 # breadcrumb, the search box, then the page in two columns - the page's body,
 # and the forum's boxes beside it. Every forum page extends this.
 #
 # The application decides what "layout1.html.twig" is; the forum only asks
 # for its `content` block, the way base-bundle's own client templates do.
 # The boxes are the forum's own right-hand column (`forum_side`), so they line
 # up with the first block of the page rather than with the site's aside.
 #}
{% extends 'layout1.html.twig' %}

{% block title %}{{ block('forum_title') is defined ? block('forum_title') : '@forum.index.title'|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('bundles/forum/css/forum.css') }}">
{% endblock %}

{% block content %}
<div class="forum">
    {% block forum_header %}
    <header class="forum-header">
        {# The application supplies the painted banner (see _banner.html.twig); this is the text fallback. #}
        {% block forum_banner %}{% include '@Forum/client/_banner.html.twig' ignore missing %}{% endblock %}

        {# A site with a breadcrumb of its own empties this block, so the trail is not drawn twice. #}
        {% block forum_breadcrumb %}
        <nav class="forum-crumbs" aria-label="{{ '@forum.crumbs'|trans }}">
            <a href="{{ path('forum_index') }}"><i class="fa-solid fa-comments"></i> {{ '@forum.index.title'|trans }}</a>
            {% block forum_crumbs %}{% endblock %}
        </nav>
        {% endblock %}

        {# The index's two views - see ForumController::VIEWS. Only where there is a view to switch. #}
        {% if view is defined %}
        <div class="forum-views" role="group" aria-label="{{ '@forum.view.label'|trans }}">
            <a class="forum-view{{ view == 'classique' ? ' is-active' }}" href="{{ path('forum_index', {vue: 'classique'}) }}"{{ view == 'classique' ? ' aria-current="page"' }}><i class="fa-solid fa-table-list"></i> {{ '@forum.view.classique'|trans }}</a>
            <a class="forum-view{{ view == 'fil' ? ' is-active' }}" href="{{ path('forum_index', {vue: 'fil'}) }}"{{ view == 'fil' ? ' aria-current="page"' }}><i class="fa-solid fa-stream"></i> {{ '@forum.view.fil'|trans }}</a>
        </div>
        {% endif %}

        <form class="forum-search" action="{{ path('forum_search') }}" method="get" role="search">
            <input type="search" name="q" value="{{ term|default('') }}" minlength="3" placeholder="{{ '@forum.search.placeholder'|trans }}" aria-label="{{ '@forum.search.placeholder'|trans }}">
            <button type="submit" aria-label="{{ '@forum.search.go'|trans }}"><i class="fa-solid fa-magnifying-glass"></i></button>
        </form>
    </header>
    {% endblock %}

    {% include 'flashbag.html.twig' ignore missing %}

    {#
     # The page, then the boxes beside it, both starting on the same line. A
     # page adds to the column with {{ parent() }} in `forum_side` (the topic's
     # timeline does); nothing above it clips, so a child may be sticky.
     #}
    <div class="forum-page">
        <div class="forum-main">{% block forum_body %}{% endblock %}</div>
        <aside class="forum-side">
            {% block forum_side %}
                {% include '@Forum/client/_aside.html.twig' with {tags: tags|default([])} %}
            {% endblock %}
        </aside>
    </div>

    {# Under the page, for a site that wants something there; empty by default. #}
    {% block forum_footer %}{% endblock %}
</div>
{% endblock %}
