{% extends '@Forum/client/layout.html.twig' %}

{#
 # The right-hand column holds the timeline, and only the timeline: beside a
 # topic there is nothing to read but the topic. A layout with a `forum_side`
 # block places it; an older layout without one gets the column drawn here,
 # beside the topic (see .forum-thread-grid).
 #}
{% set layout_has_side = block('forum_side', '@Forum/client/layout.html.twig') is defined %}
{% set has_icons = source('@Forum/client/_icon.html.twig', true) is not empty %}

{% block forum_title %}{{ topic.title }}{% endblock %}
{% block forum_crumbs %}
    {% set cat = topic.category %}
    {% if cat and cat.parent %}<span>›</span> <a href="{{ path('forum_category', {slug: cat.parent.slug}) }}">{{ cat.parent.title }}</a>{% endif %}
    {% if cat %}<span>›</span> <a href="{{ path('forum_category', {slug: cat.slug}) }}">{{ cat.title }}</a>{% endif %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('bundles/forum/css/forum-thread.css') }}">
{% endblock %}

{% block forum_body %}
    {% if layout_has_side %}
        {{ block('forum_topic') }}
    {% else %}
        <div class="forum-thread-grid">
            <div class="forum-main">{{ block('forum_topic') }}</div>
            <aside class="forum-side">{{ block('forum_side') }}</aside>
        </div>
    {% endif %}
{% endblock %}

{% block forum_side %}
    {{ block('forum_timeline') }}
{% endblock %}

{% block forum_topic %}
    {% set can_moderate = is_granted('FORUM_MODERATE') %}
    {% set can_edit_topic = is_granted('FORUM_EDIT', topic) %}

    {% set retro = topic_style|default('retro') == 'retro' %}
    <article class="forum-topic is-style-{{ retro ? 'retro' : 'cartes' }}" id="topic-{{ topic.id }}">
        <header class="forum-topic-head">
            <h2 class="forum-topic-heading">
                {% if topic.pinned %}<i class="fa-solid fa-thumbtack" title="{{ '@forum.topic.pinned'|trans }}"></i>{% endif %}
                {% if topic.locked %}<i class="fa-solid fa-lock" title="{{ '@forum.topic.locked'|trans }}"></i>{% endif %}
                {{ topic.title }}
            </h2>
            <div class="forum-topic-meta">
                {% for tag in topic.tags %}
                    <a class="forum-tag forum-tag-sm" href="{{ path('forum_tag', {slug: tag.slug}) }}" style="{{ tag.color ? '--tag:' ~ tag.color : '' }}">{{ tag }}</a>
                {% endfor %}
                <span class="forum-topic-stats">
                    <i class="fa-regular fa-comment"></i> {{ topic.replies }}
                    <i class="fa-regular fa-eye"></i> {{ topic.views }}
                    <i class="fa-regular fa-heart"></i> <span data-forum-likes>{{ topic.likes|length }}</span>
                </span>
            </div>

            <div class="forum-topic-actions">
                {% if is_granted('ROLE_USER') %}
                    <button type="button" class="forum-btn forum-btn-ghost{{ is_liked ? ' is-active' }}" data-forum-like data-like="{{ path('api_thread_like', {slug: topic.slug}) }}" data-unlike="{{ path('api_thread_unlike', {slug: topic.slug}) }}" aria-pressed="{{ is_liked ? 'true' : 'false' }}">
                        <i class="fa-solid fa-heart"></i> <span>{{ (is_liked ? '@forum.topic.liked' : '@forum.topic.like')|trans }}</span>
                    </button>
                    <button type="button" class="forum-btn forum-btn-ghost{{ is_following ? ' is-active' }}" data-forum-follow data-follow="{{ path('api_thread_follow', {slug: topic.slug}) }}" data-unfollow="{{ path('api_thread_unfollow', {slug: topic.slug}) }}" aria-pressed="{{ is_following ? 'true' : 'false' }}">
                        <i class="fa-solid fa-bell"></i> <span>{{ (is_following ? '@forum.topic.following' : '@forum.topic.follow')|trans }}</span>
                    </button>
                {% endif %}
                {% if can_edit_topic %}
                    <a class="forum-btn forum-btn-ghost" href="{{ path('forum_topic_edit', {slug: topic.slug}) }}"><i class="fa-solid fa-pen"></i> {{ '@forum.topic.edit'|trans }}</a>
                {% endif %}
                {% if can_moderate or can_edit_topic %}
                <form class="forum-moderate" method="post" action="{{ path('forum_topic_moderate', {slug: topic.slug, action: 'pin'}) }}" data-forum-moderate>
                    <input type="hidden" name="_token" value="{{ csrf_token('forum_moderate_' ~ topic.id) }}">
                    {% if can_moderate %}
                        <button class="forum-btn forum-btn-ghost" formaction="{{ path('forum_topic_moderate', {slug: topic.slug, action: topic.pinned ? 'unpin' : 'pin'}) }}"><i class="fa-solid fa-thumbtack"></i> {{ (topic.pinned ? '@forum.moderate.unpin' : '@forum.moderate.pin')|trans }}</button>
                        <button class="forum-btn forum-btn-ghost" formaction="{{ path('forum_topic_moderate', {slug: topic.slug, action: topic.locked ? 'unlock' : 'lock'}) }}"><i class="fa-solid fa-{{ topic.locked ? 'lock-open' : 'lock' }}"></i> {{ (topic.locked ? '@forum.moderate.unlock' : '@forum.moderate.lock')|trans }}</button>
                    {% endif %}
                    <button class="forum-btn forum-btn-danger" formaction="{{ path('forum_topic_moderate', {slug: topic.slug, action: 'delete'}) }}" data-confirm="{{ '@forum.moderate.delete_confirm'|trans }}"><i class="fa-solid fa-trash"></i> {{ '@forum.moderate.delete'|trans }}</button>
                </form>
                {% endif %}
            </div>
        </header>

        {{ block('forum_pager') }}

        {#
         # The 2005 box: the page's messages in one white box, its bar of
         # « Sujet Précédent / Sujet Suivant » (the same board) on top, the
         # messages as rows under a thin rule, "Page n/N" at the foot.
         #}
        <div class="forum-topic-box">
            {# The bar always heads the 2005 box; the cards only draw it when there is somewhere to go. #}
            {% if retro or topic_previous or topic_next %}
            <nav class="forum-topic-nav" aria-label="{{ '@forum.timeline.neighbours'|trans }}">
                {% if topic_previous %}<a rel="prev" href="{{ path('forum_topic', {slug: topic_previous.slug}) }}">« {{ '@forum.timeline.previous_topic'|trans }}</a>{% else %}<span></span>{% endif %}
                {% if topic_next %}<a rel="next" href="{{ path('forum_topic', {slug: topic_next.slug}) }}">{{ '@forum.timeline.next_topic'|trans }} »</a>{% else %}<span></span>{% endif %}
            </nav>
            {% endif %}

            {#
             # The stream: forum-thread.js adds the pages before and after this
             # one as the reader scrolls, and fetches the page of a message the
             # timeline or a link jumps to - one topic to read from end to end,
             # as Discourse has it. The pagers stay for a reader without the
             # script, and for the search engines.
             #}
            <ol class="forum-posts" start="{{ (posts.page - 1) * posts.pageSize + 1 }}" data-forum-stream data-page="{{ posts.page }}" data-pages="{{ max(posts.totalPages, 1) }}">
                {% for post in posts %}
                    {% include '@Forum/client/_post.html.twig' with {post: post, topic: topic, node: outline_index[post.id] ?? null, current_page: posts.page, retro: retro} %}
                {% endfor %}
            </ol>

            {% if retro %}<p class="forum-topic-pagecount" data-forum-pagecount data-label="{{ '@forum.topic.page_of'|trans({page: '{page}', total: '{total}'}) }}">{{ '@forum.topic.page_of'|trans({page: posts.page, total: max(posts.totalPages, 1)}) }}</p>{% endif %}
        </div>

        {# Under the box, as the 2005 page had them: a new topic on this board, and the lock when the topic is closed. #}
        <div class="forum-topic-badges">
            {% if topic.category and is_granted('FORUM_POST', topic.category) %}
                {% include '@Forum/client/_badge.html.twig' with {name: 'new_topic', href: path('forum_topic_new', {category: topic.category.slug}), title: '@forum.topic.new'|trans} %}
            {% endif %}
            {% if topic.locked %}
                {% include '@Forum/client/_badge.html.twig' with {name: 'locked_topic', title: '@forum.topic.locked'|trans} %}
            {% endif %}
        </div>

        {{ block('forum_pager') }}

        {% if reply %}
        <section class="forum-reply" id="reply">
            <h3><i class="fa-solid fa-reply"></i> {{ '@forum.reply.title'|trans }}</h3>
            {{ form_start(reply, {attr: {class: 'forum-form'}}) }}
                {% set answered = reply.vars.value.replyTo ? outline_index[reply.vars.value.replyTo] ?? null : null %}
                {% if answered %}
                    <input type="hidden" name="reply_to" value="{{ answered.id }}">
                    <p class="forum-reply-to">
                        <i class="fa-solid fa-code-branch" aria-hidden="true"></i>
                        <a href="{{ answered.page != posts.page ? path('forum_topic', {slug: topic.slug, page: answered.page > 1 ? answered.page : null}) }}#post-{{ answered.id }}">{{ '@forum.reply.in_reply_to'|trans({number: answered.number}) }}</a>
                        · <a href="{{ path('forum_topic', {slug: topic.slug, page: posts.page > 1 ? posts.page : null}) }}#reply">{{ '@forum.post.branch_cancel'|trans }}</a>
                    </p>
                {% endif %}
                {{ form_row(reply.content) }}
                <div class="forum-form-actions">
                    <button type="submit" class="forum-btn forum-btn-primary"><i class="fa-solid fa-paper-plane"></i> {{ '@forum.reply.send'|trans }}</button>
                </div>
            {{ form_end(reply) }}
        </section>
        {% elseif topic.locked %}
            <p class="forum-locked-note"><i class="fa-solid fa-lock"></i> {{ '@forum.topic.locked_note'|trans }}</p>
        {% elseif not is_granted('ROLE_USER') %}
            <p class="forum-locked-note">{{ '@forum.aside.login_to_write'|trans({'%login%': path('security_login'), '%register%': path('security_register')})|raw }}</p>
        {% endif %}

        {# "Sauter vers", the 2005 way out of a topic: every board the reader may read (TopicController::jumpBoards), the "go" taking them there (forum.js). #}
        {% if jump_boards|default([])|length %}
        <form class="forum-jump" method="get" action="{{ path('forum_index') }}" data-forum-jump>
            <label for="forum-jump-to">{{ '@forum.topic.jump_to'|trans }}</label>
            <select id="forum-jump-to" name="to">
                {% for group, boards in jump_boards %}
                <optgroup label="{{ group }}">
                    {% for board in boards %}<option value="{{ path('forum_category', {slug: board.slug}) }}"{{ topic.category and board.id == topic.category.id ? ' selected' }}>{{ board.title }}</option>{% endfor %}
                </optgroup>
                {% endfor %}
            </select>
            {% include '@Forum/client/_badge.html.twig' with {name: 'go', button: true, title: '@forum.topic.go'|trans} %}
        </form>
        {% endif %}
    </article>
{% endblock %}

{#
 # The topic's pages, above and below the posts: the BBS's one pager
 # (_pager.html.twig), the same row of arrows and numbers the board, tag,
 # search and feed lists draw.
 #}
{% block forum_pager %}
{% include '@Forum/client/_pager.html.twig' with {pagination: posts, route: 'forum_topic', params: {slug: topic.slug}} %}
{% endblock %}

{#
 # The timeline (Discourse's scroller), drawn by forum-thread.js from the
 # outline below - hidden until the script runs, since it means nothing
 # without it. Which message answers which is read in the thread itself.
 #}
{% block forum_timeline %}
{% set total = outline|length %}
<nav class="forum-timeline" aria-label="{{ '@forum.timeline.label'|trans }}" data-forum-timeline hidden>
    <button type="button" class="forum-timeline-pill" data-timeline-pill aria-expanded="false" aria-controls="forum-timeline-panel" title="{{ '@forum.timeline.where'|trans }}">
        <i class="fa-solid fa-signs-post" aria-hidden="true"></i> <span data-timeline-pill-label>1 / {{ total }}</span>
    </button>
    <div class="forum-timeline-panel" id="forum-timeline-panel">
        <div class="forum-timeline-scroller" data-timeline-scroller>
            <button type="button" class="forum-timeline-jump" data-timeline-top><i class="fa-solid fa-angles-up" aria-hidden="true"></i> {{ '@forum.timeline.top'|trans }}</button>
            <span class="forum-timeline-date" data-timeline-start></span>
            <div class="forum-timeline-track" data-timeline-track>
                <span class="forum-timeline-fill" data-timeline-fill></span>
                <span class="forum-timeline-ticks" data-timeline-ticks aria-hidden="true"></span>
                <div class="forum-timeline-handle" data-timeline-handle role="slider" tabindex="0" aria-orientation="vertical"
                     aria-label="{{ '@forum.timeline.slider'|trans }}" aria-valuemin="1" aria-valuemax="{{ total }}" aria-valuenow="1">
                    <span class="forum-timeline-knob"></span>
                    <span class="forum-timeline-where"><b data-timeline-label>1 / {{ total }}</b><small data-timeline-date></small></span>
                </div>
            </div>
            <span class="forum-timeline-date" data-timeline-end></span>
            <button type="button" class="forum-timeline-jump" data-timeline-bottom><i class="fa-solid fa-angles-down" aria-hidden="true"></i> {{ '@forum.timeline.bottom'|trans }}</button>
        </div>
    </div>

    <script type="application/json" id="forum-outline">{{ {
        posts: outline,
        page: posts.page,
        url: path('forum_topic', {slug: topic.slug}),
        labels: {
            loading: '@forum.stream.loading'|trans,
            failed: '@forum.stream.failed'|trans,
            position: '@forum.timeline.position'|trans({current: '{current}', total: '{total}'}),
        },
    }|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
</nav>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('bundles/forum/js/forum.js') }}" defer></script>
    <script src="{{ asset('bundles/forum/js/forum-thread.js') }}" defer></script>
{% endblock %}
