{% extends '@Forum/client/layout.html.twig' %}

{% block forum_title %}{{ '@forum.topic.new'|trans }}{% endblock %}
{% block forum_crumbs %}
    {% if category and category.parent %}<span>›</span> <a href="{{ path('forum_category', {slug: category.parent.slug}) }}">{{ category.parent.title }}</a>{% endif %}
    {% if category %}<span>›</span> <a href="{{ path('forum_category', {slug: category.slug}) }}">{{ category.title }}</a>{% endif %}
    <span>›</span> <span>{{ '@forum.topic.new'|trans }}</span>
{% endblock %}

{% block forum_body %}
    <section class="forum-board-head">
        <div class="forum-board-head-text">
            <h2><i class="fa-solid fa-pen-nib"></i> {{ '@forum.topic.new'|trans }}</h2>
            <p>{{ '@forum.topic.new_hint'|trans }}</p>
            {# Started from a message (TopicController::Create, ?depuis=): where it comes from. #}
            {% if source|default(null) %}
                <p class="forum-linked-from"><i class="fa-solid fa-diagram-project" aria-hidden="true"></i> {{ '@forum.topic.linked_from'|trans }} <a href="{{ source_url }}">« {{ source.topic.title }} », #{{ source.number }}</a></p>
            {% endif %}
        </div>
    </section>

    {{ form_start(form, {attr: {class: 'forum-form forum-form-topic'}}) }}
        {{ form_row(form.title) }}
        {{ form_row(form.category) }}
        {{ form_row(form.tags) }}
        {{ form_row(form.content) }}
        {# The poll: folded away unless it has something in it (a form sent back with errors). #}
        {% set poll_open = form.pollQuestion.vars.value or form.pollOptions.vars.value or not form.pollQuestion.vars.valid or not form.pollOptions.vars.valid %}
        <details class="forum-form-poll"{{ poll_open ? ' open' }}>
            <summary><i class="fa-solid fa-square-poll-horizontal" aria-hidden="true"></i> {{ '@forum.poll.form.legend'|trans }}</summary>
            {{ form_row(form.pollQuestion) }}
            {{ form_row(form.pollOptions) }}
        </details>
        <div class="forum-form-actions">
            <button type="submit" class="forum-btn forum-btn-primary"><i class="fa-solid fa-paper-plane"></i> {{ '@forum.topic.publish'|trans }}</button>
            <a class="forum-btn forum-btn-ghost" href="{{ category ? path('forum_category', {slug: category.slug}) : path('forum_index') }}">{{ '@forum.form.cancel'|trans }}</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
