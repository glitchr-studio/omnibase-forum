{% extends '@Forum/client/layout.html.twig' %}

{% block forum_title %}{{ '@forum.topic.new'|trans }}{% endblock %}
{% block forum_crumbs %}
    {% if category and category.parent %}<span>›</span> <a href="{{ path('forum_category', {slug: category.parent.slug}) }}">{{ category.parent.title }}</a>{% endif %}
    {% if category %}<span>›</span> <a href="{{ path('forum_category', {slug: category.slug}) }}">{{ category.title }}</a>{% endif %}
    <span>›</span> <span>{{ '@forum.topic.new'|trans }}</span>
{% endblock %}

{% block forum_body %}
    <section class="forum-board-head">
        <div class="forum-board-head-text">
            <h2><i class="fa-solid fa-pen-nib"></i> {{ '@forum.topic.new'|trans }}</h2>
            <p>{{ '@forum.topic.new_hint'|trans }}</p>
            {# Started from a message (TopicController::Create, ?depuis=): where it comes from. #}
            {% if source|default(null) %}
                <p class="forum-linked-from"><i class="fa-solid fa-diagram-project" aria-hidden="true"></i> {{ '@forum.topic.linked_from'|trans }} <a href="{{ source_url }}">« {{ source.topic.title }} », #{{ source.number }}</a></p>
            {% endif %}
        </div>
    </section>

    {{ form_start(form, {attr: {class: 'forum-form forum-form-topic'}}) }}
        {# What belongs to no field on the page (an expired token, a field the form leaves out): said, not swallowed. #}
        {{ form_errors(form) }}
        {{ form_row(form.title) }}
        {# Started from a board: that one, and nothing to choose (TopicController::Create, fixed_category). #}
        {% if form.category is defined %}{{ form_row(form.category) }}{% endif %}
        {{ form_row(form.tags) }}
        {# The poll: folded away unless it has something in it (a form sent back with errors). #}
        {% set poll_open = form.pollQuestion.vars.value or form.pollOptions.vars.value or not form.pollQuestion.vars.valid or not form.pollOptions.vars.valid or not form.pollMax.vars.valid %}
        {# A board that takes no poll (Category::$polls): the section is not offered - forum-poll.js hides it when the board is chosen in the form. #}
        <details class="forum-form-poll"{{ poll_open ? ' open' }}{{ form.category is not defined and category and not category.allowsPolls ? ' hidden' }}>
            <summary><i class="fa-solid fa-square-poll-horizontal" aria-hidden="true"></i> {{ '@forum.poll.form.legend'|trans }}</summary>
            {{ form_row(form.pollQuestion) }}
            {{ form_row(form.pollOptions) }}
            {{ form_row(form.pollMax) }}
            {# forum-poll.js draws the answers here - a row each, with the radio or box a voter will see - and writes them back into the two fields above. #}
            <div class="forum-poll-builder" data-forum-poll-builder data-max="{{ constant('Base\\Forum\\Entity\\Poll::MAX_OPTIONS') }}" data-labels="{{ {
                one: '@forum.poll.form.one'|trans, many: '@forum.poll.form.many'|trans, upTo: '@forum.poll.form.up_to'|trans,
                max: '@forum.poll.form.max'|trans, answer: '@forum.poll.form.answer'|trans({n: '{n}'}),
                add: '@forum.poll.form.add'|trans, remove: '@forum.poll.form.remove'|trans,
            }|json_encode|e('html_attr') }}"></div>
        </details>
        <script src="{{ asset('bundles/forum/js/forum-poll.js') }}" defer></script>
        {{ form_row(form.content) }}
        {# When it comes out, and in whose name: only for those who may (TopicController). #}
        {% if form.author is defined or form.publishedAt is defined %}
            <fieldset class="forum-form-publish">
                {% if form.author is defined %}{{ form_row(form.author) }}{% endif %}
                {% if form.publishedAt is defined %}{{ form_row(form.publishedAt) }}{% endif %}
            </fieldset>
        {% endif %}
        <div class="forum-form-actions">
            <button type="submit" class="forum-btn forum-btn-primary"><i class="fa-solid fa-paper-plane"></i> {{ '@forum.topic.publish'|trans }}</button>
            <a class="forum-btn forum-btn-ghost" href="{{ category ? path('forum_category', {slug: category.slug}) : path('forum_index') }}">{{ '@forum.form.cancel'|trans }}</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
