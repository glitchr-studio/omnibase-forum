{#
 # One post of a topic. Variables: post, topic; from topic/show.html.twig also
 # `node` (the post's entry in TopicController::outline()), `outline_index`,
 # `current_page` and `has_icons` - without them the post still renders, only
 # without its branch links.
 #
 # Laid out like the 2004 BBS: the minipost icon before the header, the tools
 # (quote, reply to this post, edit, delete) top-right, a thin rule under it.
 #}
{% import _self as ui %}

{% macro icon(name, fa, has_icons) %}
    {%- if has_icons -%}
        {% include '@Forum/client/_icon.html.twig' with {name: name} %}
    {%- else -%}
        <i class="fa-solid fa-{{ fa }}" aria-hidden="true"></i>
    {%- endif -%}
{% endmacro %}

{% set can_edit = is_granted('FORUM_EDIT', post) %}
{% set can_moderate = is_granted('FORUM_MODERATE') %}
{% set can_reply = is_granted('FORUM_REPLY', topic) and not post.deleted %}
{% set has_icons = has_icons ?? (source('@Forum/client/_icon.html.twig', true) is not empty) %}
{% set node = node ?? null %}
{% set current_page = current_page ?? 1 %}
{% set outline_index = outline_index ?? {} %}
{# The 2005 look (topic/show.html.twig's `retro`): the member drawn large with the day under. #}
{% set retro = retro ?? true %}

{# A link to another post of the topic, on whichever page it is. #}
{% macro href(entry, topic, current_page) -%}
    {{ entry.page != current_page ? path('forum_topic', {slug: topic.slug, page: entry.page > 1 ? entry.page : null}) }}#post-{{ entry.id }}
{%- endmacro %}

{# How many forks from the trunk this message is (TopicController::outline()'s
   `level`, not `depth`, which is the place along a branch): the cards step in
   by it, so a reply is read under the message it answers. #}
<li class="forum-post{{ post.isFirst ? ' is-first' }}{{ post.deleted ? ' is-deleted' }}{{ node and node.branch ? ' is-branch' }}" id="post-{{ post.id }}"{% if node and node.level %} style="--post-level: {{ node.level }}"{% endif %}>
    {# The 2005 column: the member, their name in the rank's colour, the day and the hour under it. #}
    <aside class="forum-post-author">
        {# The large box in both styles: the 2005 square is what a member is
           drawn in (a site whose members are art shows a whole figure in it,
           not a head in a disc), and the cards were showing a smaller one. #}
        {% include '@Forum/client/_avatar.html.twig' with {user: post.author, size: 'lg'} %}
        <div class="forum-post-author-name">{% include '@Forum/client/_member.html.twig' with {user: post.author} %}</div>
        {% if retro %}
            <time class="forum-post-when" datetime="{{ post.createdAt|date('c') }}">{{ post.createdAt|datetime('d MMMM yyyy') }}<br>{{ post.createdAt|datetime('HH:mm') }}</time>
        {% elseif post.author and post.author.level is defined %}
            <div class="forum-post-author-level">{{ '@forum.member.level'|trans({'%level%': post.author.level}) }}</div>
        {% endif %}
    </aside>

    <div class="forum-post-body">
        <header class="forum-post-head">
            <a class="forum-post-minipost" href="#post-{{ post.id }}" title="{{ '@forum.post.permalink'|trans }}" aria-label="{{ '@forum.post.permalink'|trans }}">{{ ui.icon('minipost', 'message', has_icons) }}</a>
            {#
             # No subject line on each message, though the 2005 board had one
             # ("Re: <the topic's title>"): the title is already the page's
             # trail and its heading, and a third copy on every message was
             # the topic's name written out more often than anything said in it.
             #}
            <a class="forum-post-number" href="#post-{{ post.id }}">#{{ node ? node.number : post.number }}</a>
            {% if not retro %}<time datetime="{{ post.createdAt|date('c') }}">{{ post.createdAt|datetime('d MMMM yyyy, HH:mm') }}</time>{% endif %}

            {# "en réponse à": only where the post leaves the trunk - the trunk simply follows on. #}
            {% if node %}
                {% set answered = node.branch and node.parent ? outline_index[node.parent] ?? null : null %}
                {% if answered %}
                    <a class="forum-post-replyto" href="{{ ui.href(answered, topic, current_page) }}">↳ {{ '@forum.post.reply_to'|trans({number: answered.number}) }}</a>
                {% endif %}
            {% elseif post.replyTo %}
                <a class="forum-post-replyto" href="#post-{{ post.replyTo.id }}">↳ {{ '@forum.post.reply_to'|trans({number: post.replyTo.number}) }}</a>
            {% endif %}

            {% if post.editedAt %}
                <span class="forum-post-edited" title="{{ post.editedAt|datetime('d MMMM yyyy, HH:mm') }}">{{ '@forum.post.edited'|trans({'%count%': post.editCount}) }}</span>
            {% endif %}

            <div class="forum-post-tools" role="group" aria-label="{{ '@forum.post.tools'|trans }}">
                {% if can_reply %}
                    <a class="forum-post-tool" href="{{ path('forum_topic', {slug: topic.slug, quote: post.id}) }}#reply" title="{{ '@forum.post.quote'|trans }}" aria-label="{{ '@forum.post.quote'|trans }}">{{ ui.icon('quote', 'quote-left', has_icons) }}</a>
                    <a class="forum-post-tool" href="{{ path('forum_topic', {slug: topic.slug, reply: post.id}) }}#reply" title="{{ '@forum.post.branch'|trans }}" aria-label="{{ '@forum.post.branch'|trans }}">{{ ui.icon('branch', 'code-branch', has_icons) }}</a>
                {% endif %}
                {# A new topic out of this message, when the talk wanders off (Discourse's "reply as linked topic"). #}
                {% if not post.deleted and topic.category and is_granted('FORUM_POST', topic.category) %}
                    <a class="forum-post-tool" href="{{ path('forum_topic_new', {category: topic.category.slug, depuis: post.id}) }}" title="{{ '@forum.post.linked_topic'|trans }}" aria-label="{{ '@forum.post.linked_topic'|trans }}">{{ ui.icon('linked_topic', 'square-plus', has_icons) }}</a>
                {% endif %}
                {% if can_edit and not post.deleted %}
                    <a class="forum-post-tool" href="{{ path('forum_post_edit', {id: post.id}) }}" title="{{ '@forum.post.edit'|trans }}" aria-label="{{ '@forum.post.edit'|trans }}">{{ ui.icon('edit', 'pen', has_icons) }}</a>
                {% endif %}
                {% if can_edit and (not post.deleted or can_moderate) %}
                    {% set delete_label = (post.deleted ? '@forum.post.restore' : '@forum.post.delete')|trans %}
                    <form method="post" action="{{ path('forum_post_delete', {id: post.id}) }}" class="forum-inline-form" data-forum-moderate>
                        <input type="hidden" name="_token" value="{{ csrf_token('forum_post_' ~ post.id) }}">
                        <button class="forum-post-tool is-danger" title="{{ delete_label }}" aria-label="{{ delete_label }}" data-confirm="{{ (post.deleted ? '@forum.post.restore_confirm' : '@forum.post.delete_confirm')|trans }}">
                            {%- if post.deleted %}<i class="fa-solid fa-rotate-left" aria-hidden="true"></i>{% else %}{{ ui.icon('delete', 'trash', has_icons) }}{% endif -%}
                        </button>
                    </form>
                {% endif %}
            </div>
        </header>
        <hr class="forum-post-sep">

        {% if post.deleted %}
            <div class="forum-post-content forum-post-deleted">
                <i class="fa-solid fa-eraser"></i> {{ '@forum.post.deleted'|trans }}
                {% if can_moderate %}<details><summary>{{ '@forum.post.show_deleted'|trans }}</summary>{{ post.content|forum_markdown }}</details>{% endif %}
            </div>
        {% else %}
            <div class="forum-post-content">{{ post.content|forum_markdown }}</div>
        {% endif %}

        {% set first_reply = node and node.firstReply ? outline_index[node.firstReply] ?? null : null %}
        {% if first_reply %}
        <footer class="forum-post-foot">
            <a class="forum-post-branches" href="{{ ui.href(first_reply, topic, current_page) }}">{{ ui.icon('branch', 'code-branch', has_icons) }} {{ '@forum.post.replies'|trans({count: node.replies}) }}</a>
        </footer>
        {% endif %}
    </div>
</li>
