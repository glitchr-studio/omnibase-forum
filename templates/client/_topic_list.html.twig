{#
 # The topic list: the folder badge, which alone says the topic's state
 # (pinned, locked, hot or plain); the title with its tags and author; then the
 # counters and the last message, when and who, with the envelope leading to
 # it. Variables: topics (a Pagination), show_category (bool), and stream_url -
 # the list's address without its page - for a list read as one as the reader
 # scrolls (forum-feed.js); without it, the pager alone moves through it.
 #}
{# Not |default(true): Twig's default takes false for empty, and the board's own page passes false. #}
{% set show_category = show_category is defined ? show_category : true %}
{# Pagination::count() is never 0 - the total says whether there is anything. #}
{% if (topics.totalCount ?? topics|length) == 0 %}
    <p class="forum-empty">{{ '@forum.list.empty'|trans }}</p>
{% else %}
<table class="forum-topics">
    <thead>
        <tr>
            <th class="col-topic">{{ '@forum.list.topic'|trans }}</th>
            {% if show_category %}<th class="col-cat">{{ '@forum.list.board'|trans }}</th>{% endif %}
            <th class="col-num">{{ '@forum.list.replies'|trans }}</th>
            <th class="col-num">{{ '@forum.list.views'|trans }}</th>
            <th class="col-activity">{{ '@forum.list.activity'|trans }}</th>
        </tr>
    </thead>
    {% set streamed = stream_url is defined and stream_url and (topics.totalPages ?? 1) > 1 %}
    <tbody{% if streamed %} data-forum-feed data-page="{{ topics.page }}" data-pages="{{ topics.totalPages }}" data-url="{{ stream_url }}" data-loading="{{ '@forum.stream.loading'|trans }}" data-failed="{{ '@forum.stream.failed'|trans }}"{% endif %}>
    {% for topic in topics %}
        {% include '@Forum/client/_topic_row.html.twig' with {topic: topic, show_category: show_category, page: topics.page ?? 1} %}
    {% endfor %}
    </tbody>
</table>
{# What the badges above mean - the 2004 board carried the same block under every list. #}
{% include '@Forum/client/_legend.html.twig' with {scope: 'topic'} only %}
{% endif %}
