{#
 # The right-hand column: what to know first, a call to write, then the tag
 # cloud. `boxes` says which of the three to draw, in case a view wants them
 # in two places - the feed keeps the help beside it and shelves the other
 # two under the page (index_fil.html.twig).
 #}
{% set boxes = boxes|default(['help', 'new', 'tags']) %}

{% if 'help' in boxes %}
<div class="forum-box forum-box-help">
    <div class="forum-box-title"><i class="fa-solid fa-circle-question"></i> {{ '@forum.aside.help'|trans }}</div>
    <div class="forum-box-body">
        {# The syntax is shown as typed, in code chips: rendering it would hide what to type. #}
        <p>{{ '@forum.aside.help_markdown'|trans|raw }}</p>
        <p>{{ '@forum.aside.help_mention'|trans|raw }}</p>
    </div>
</div>
{% endif %}

{% if 'new' in boxes %}
<div class="forum-box forum-box-new">
    <div class="forum-box-title"><i class="fa-solid fa-pen-nib"></i> {{ '@forum.aside.write'|trans }}</div>
    <div class="forum-box-body">
        {% if is_granted('ROLE_USER') %}
            <a class="forum-btn forum-btn-primary" href="{{ path('forum_topic_new', category is defined and category and category.isBoard ? {category: category.slug} : {}) }}">
                <i class="fa-solid fa-plus"></i> {{ '@forum.topic.new'|trans }}
            </a>
        {% else %}
            <p>{{ '@forum.aside.login_to_write'|trans({'%login%': path('security_login'), '%register%': path('security_register')})|raw }}</p>
        {% endif %}
    </div>
</div>
{% endif %}

{% if 'tags' in boxes and tags is defined and tags|length %}
<div class="forum-box forum-box-tags">
    <div class="forum-box-title"><i class="fa-solid fa-tags"></i> {{ '@forum.aside.tags'|trans }}</div>
    <div class="forum-box-body forum-tagcloud">
        {% for row in tags %}
            {% set tag = row.tag %}
            <a class="forum-tag" href="{{ path('forum_tag', {slug: tag.slug}) }}" style="{{ tag.color ? '--tag:' ~ tag.color : '' }}">
                {{ tag }} <span class="forum-tag-count">{{ row.nb }}</span>
            </a>
        {% endfor %}
    </div>
</div>
{% endif %}
