{% extends '@Forum/client/layout.html.twig' %}

{% block forum_title %}{{ category.title }}{% endblock %}
{% block forum_crumbs %}
    {% if category.parent %}<span>›</span> <a href="{{ path('forum_category', {slug: category.parent.slug}) }}">{{ category.parent.title }}</a>{% endif %}
    <span>›</span> <span>{{ category.title }}</span>
{% endblock %}

{% block forum_body %}
    {# The board's head: its folder badge says whether it is locked, the title stays plain. #}
    <section class="forum-board-head" style="{{ category.color ? '--cat:' ~ category.color : '' }}">
        <div class="forum-board-head-text">
            <h2>{% include '@Forum/client/_folder.html.twig' with {state: category.locked ? 'lock' : (category.requiredRole ? 'announce' : 'default'), size: 32, title: category.locked ? '@forum.board.locked'|trans : ''} %} {{ category.title }}</h2>
            {% if category.description %}<p>{{ category.description }}</p>{% endif %}
            {% if category.locked %}<p class="forum-board-head-note">{{ '@forum.board.locked'|trans }}</p>{% endif %}
        </div>
        {% if is_granted('FORUM_POST', category) %}
            <a class="forum-btn forum-btn-primary" href="{{ path('forum_topic_new', {category: category.slug}) }}"><i class="fa-solid fa-plus"></i> {{ '@forum.topic.new'|trans }}</a>
        {% endif %}
    </section>

    {# Read as one list as the reader scrolls (forum-feed.js); the pager stays for a reader without the script. #}
    <div class="forum-list-stream">
        {% include '@Forum/client/_topic_list.html.twig' with {topics: topics, show_category: false, stream_url: path('forum_category', {slug: category.slug})} %}
        {% include '@Forum/client/_pager.html.twig' with {pagination: topics, route: 'forum_category', params: {slug: category.slug}} %}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('bundles/forum/js/forum-feed.js') }}" defer></script>
{% endblock %}
