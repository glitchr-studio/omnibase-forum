{#
 # The index as a flat feed, Discourse-like: the staff's announcements on top,
 # the pinned topics as post-its, then every discussion of every readable
 # board by last activity, each labelled with its board. The classic view
 # (index.html.twig) keeps the grouped board list; ForumController::Index
 # picks one or the other. Variables: announcements, pinned, latest, groups.
 #}
{% extends '@Forum/client/layout.html.twig' %}

{% block forum_body %}
    {% if announcements|length %}
    <section class="forum-announcements" aria-label="{{ '@forum.fil.announcements'|trans }}">
        {% for topic in announcements %}
        <a class="forum-announcement" href="{{ path('forum_topic', {slug: topic.slug}) }}" style="{{ topic.category and topic.category.color ? '--cat:' ~ topic.category.color : '' }}">
            <span class="forum-announcement-kicker"><i class="fa-solid fa-bullhorn"></i> {{ topic.category ? topic.category.title : '@forum.fil.announcements'|trans }}</span>
            <span class="forum-announcement-title">{{ topic.title }}</span>
            {% set at = topic.createdAt %}
            <time datetime="{{ at ? at|date('c') : '' }}">{{ at ? at|datetime('d MMMM yyyy') : '' }}</time>
        </a>
        {% endfor %}
    </section>
    {% endif %}

    {% if pinned|length %}
    <section class="forum-postits">
        <h2 class="forum-section-title"><i class="fa-solid fa-thumbtack"></i> {{ '@forum.fil.pinned'|trans }}</h2>
        <ul>
            {% for topic in pinned %}
            <li class="forum-postit" style="--tilt: {{ loop.index is odd ? '-1.2deg' : '1deg' }}">
                <a href="{{ path('forum_topic', {slug: topic.slug}) }}">
                    <span class="forum-postit-title">{{ topic.title }}</span>
                    {% if topic.category %}<span class="forum-postit-board">{{ topic.category.title }}</span>{% endif %}
                    <span class="forum-postit-meta"><i class="fa-regular fa-comment"></i> {{ topic.replies }}</span>
                </a>
            </li>
            {% endfor %}
        </ul>
    </section>
    {% endif %}

    <section class="forum-feed">
        {# The title and the boards' chips on a panel of their own, as the
           board's head is on its page (.forum-board-head): drawn bare, they
           sat on whatever the site paints its page with - on a blue page the
           title was blue on blue and the chips floated with nothing to hold
           them. #}
        <div class="forum-feed-head">
            <div class="forum-feed-headline">
                <h2 class="forum-section-title"><i class="fa-solid fa-bolt"></i> {{ (sort|default('recent') == 'popular' ? '@forum.fil.trending' : '@forum.fil.latest')|trans }}</h2>

                {# The order the feed is in - see ForumController::SORTS. #}
                <form class="forum-sorts" role="group" aria-label="{{ '@forum.fil.sort'|trans }}" method="post" action="{{ path('forum_display') }}">
                    <input type="hidden" name="back" value="{{ path('forum_index') }}">
                    <button type="submit" name="sort" value="recent" class="forum-sort{{ sort|default('recent') != 'popular' ? ' is-active' }}"{{ sort|default('recent') != 'popular' ? ' aria-current="page"' }}><i class="fa-solid fa-bolt"></i> {{ '@forum.fil.sort_recent'|trans }}</button>
                    <button type="submit" name="sort" value="popular" class="forum-sort{{ sort|default('recent') == 'popular' ? ' is-active' }}"{{ sort|default('recent') == 'popular' ? ' aria-current="page"' }}><i class="fa-solid fa-fire"></i> {{ '@forum.fil.sort_trending'|trans }}</button>
                </form>
            </div>

            {# The boards as filter chips, each leading to its own list. #}
            <nav class="forum-chips" aria-label="{{ '@forum.list.board'|trans }}">
                {% for group in groups %}
                    {% for board in group.children|filter(b => is_granted('FORUM_READ', b)) %}
                        <a class="forum-chip" href="{{ path('forum_category', {slug: board.slug}) }}" style="{{ (board.color ?: group.color) ? '--cat:' ~ (board.color ?: group.color) : '' }}">{{ board.title }}</a>
                    {% endfor %}
                {% endfor %}
            </nav>
        </div>

        {% if latest|length == 0 %}
            <p class="forum-empty">{{ '@forum.list.empty'|trans }}</p>
        {% else %}
        {#
         # The feed reads as one list, Discourse's way: forum-feed.js adds the
         # next pages as the reader nears the end - and, on a page opened past
         # the first, the pages before it above - and the pager steps aside.
         # It stays for a reader without the script, and for the search engines.
         #}
        <ol class="forum-feed-list" data-forum-feed data-page="{{ latest.page }}" data-pages="{{ max(latest.totalPages, 1) }}"
            data-url="{{ path('forum_index') }}"
            data-loading="{{ '@forum.stream.loading'|trans }}" data-failed="{{ '@forum.stream.failed'|trans }}">
            {% for topic in latest %}
                {% include '@Forum/client/_feed_row.html.twig' with {topic: topic, page: latest.page} %}
            {% endfor %}
        </ol>
        {% include '@Forum/client/_pager.html.twig' with {pagination: latest, route: 'forum_index', params: {}} %}
        {% endif %}
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('bundles/forum/js/forum-feed.js') }}" defer></script>
{% endblock %}
