{#
 # "Nouveau forum" (ForumController::CategoryNew): a board opened from the BBS
 # itself, the way a topic is started - the same head, the same card.
 #}
{% extends '@Forum/client/layout.html.twig' %}

{% block forum_title %}{{ '@forum.board.new'|trans }}{% endblock %}
{% block forum_crumbs %}
    <span>›</span> <span>{{ '@forum.board.new'|trans }}</span>
{% endblock %}

{% block forum_body %}
    <section class="forum-board-head">
        <div class="forum-board-head-text">
            <h2><i class="fa-solid fa-folder-plus"></i> {{ '@forum.board.new'|trans }}</h2>
            <p>{{ '@forum.board.new_hint'|trans }}</p>
        </div>
    </section>

    {{ form_start(form, {attr: {class: 'forum-form forum-form-topic'}}) }}
        {{ form_row(form.title) }}
        {{ form_row(form.parent) }}
        {{ form_row(form.description) }}
        {{ form_row(form.announcement) }}
        <div class="forum-form-actions">
            <button type="submit" class="forum-btn forum-btn-primary"><i class="fa-solid fa-folder-plus"></i> {{ '@forum.board.create'|trans }}</button>
            <a class="forum-btn forum-btn-ghost" href="{{ path('forum_index') }}">{{ '@forum.form.cancel'|trans }}</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
