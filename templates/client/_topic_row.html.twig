{#
 # One topic of a list (_topic_list.html.twig): its folder badge, title, tags
 # and author, board, counters and last message. Drawn by the page for the page
 # it opens on, and by the list's stream (_topic_rows.html.twig) for the pages
 # forum-feed.js adds as the reader scrolls - the one markup for both.
 # Variables: topic, show_category (bool), page (the list page it belongs to).
 #}
{#
 # phpBB's folder precedence, top down: an announcement (a topic in a
 # board only the staff writes in, the same reading the feed view
 # gives them), a post-it, a locked topic, a popular one, then the
 # plain folder. "Popular" is the site's own forum.hot_threshold,
 # asked of the extension rather than written as a number here.
 #}
{% set hot = forum_is_hot(topic) %}
{% set announce = topic.category and topic.category.locked %}
{% set state = announce ? 'announce' : (topic.pinned ? 'sticky' : (topic.locked ? 'lock' : (hot ? 'hot' : 'default'))) %}
{% set state_title = {announce: '@forum.folder.announce', sticky: '@forum.topic.pinned', lock: '@forum.topic.locked', hot: '@forum.folder.hot'}[state]|default('') %}
<tr class="forum-topic-row{{ announce ? ' is-announce' }}{{ topic.pinned ? ' is-pinned' }}{{ topic.locked ? ' is-locked' }}{{ hot ? ' is-hot' }}" data-topic="{{ topic.id }}" data-page="{{ page|default(1) }}">
    <td class="col-topic">
        <div class="forum-topic-main">
            {% include '@Forum/client/_folder.html.twig' with {state: state, title: state_title ? state_title|trans : ''} %}
            <div class="forum-topic-text">
                <a class="forum-topic-title" href="{{ path('forum_topic', {slug: topic.slug}) }}">{{ topic.title }}</a>
                <div class="forum-topic-meta">
                    {% for tag in topic.tags %}
                        <a class="forum-tag forum-tag-sm" href="{{ path('forum_tag', {slug: tag.slug}) }}" style="{{ tag.color ? '--tag:' ~ tag.color : '' }}">{{ tag }}</a>
                    {% endfor %}
                    <span class="forum-topic-by">{{ '@forum.list.by'|trans }} {% include '@Forum/client/_member.html.twig' with {user: topic.author} %}</span>
                </div>
            </div>
        </div>
    </td>
    {% if show_category %}
    <td class="col-cat">
        {% if topic.category %}
        <a class="forum-cat-badge" href="{{ path('forum_category', {slug: topic.category.slug}) }}" style="{{ topic.category.color ? '--cat:' ~ topic.category.color : '' }}">
            <span class="forum-cat-dot"></span>{{ topic.category.title }}
        </a>
        {% endif %}
    </td>
    {% endif %}
    <td class="col-num">{{ topic.replies }}</td>
    <td class="col-num">{{ topic.views }}</td>
    <td class="col-activity">
        {% set at = topic.activityAt %}
        <time datetime="{{ at ? at|date('c') : '' }}" title="{{ at ? at|datetime('d MMMM yyyy, HH:mm') : '' }}">{{ at ? at|datetime('d MMM yyyy') : '' }}</time>
        <div class="forum-topic-last">
            {% if topic.lastPoster or topic.author %}{% include '@Forum/client/_member.html.twig' with {user: topic.lastPoster ?? topic.author} %}{% endif %}
            <a class="forum-board-last-go" href="{{ path('forum_topic', {slug: topic.slug}) }}">{% include '@Forum/client/_icon.html.twig' with {name: 'latest_reply', title: '@forum.board.last_message'|trans} %}</a>
        </div>
    </td>
</tr>
