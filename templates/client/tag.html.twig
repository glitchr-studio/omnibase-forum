{% extends '@Forum/client/layout.html.twig' %}

{% block forum_title %}#{{ tag }}{% endblock %}
{% block forum_crumbs %}<span>›</span> <span><i class="fa-solid fa-tag"></i> {{ tag }}</span>{% endblock %}

{% block forum_body %}
    <section class="forum-board-head" style="{{ tag.color ? '--cat:' ~ tag.color : '' }}">
        <div class="forum-board-head-text">
            <h2><i class="fa-solid fa-tag"></i> {{ tag }}</h2>
            {% if tag.description is defined and tag.description %}<p>{{ tag.description }}</p>{% endif %}
        </div>
    </section>

    {# Read as one list as the reader scrolls (forum-feed.js); the pager stays for a reader without the script. #}
    <div class="forum-list-stream">
        {% include '@Forum/client/_topic_list.html.twig' with {topics: topics, show_category: true, stream_url: path('forum_tag', {slug: tag.slug})} %}
        {% include '@Forum/client/_pager.html.twig' with {pagination: topics, route: 'forum_tag', params: {slug: tag.slug}} %}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('bundles/forum/js/forum-feed.js') }}" defer></script>
{% endblock %}
