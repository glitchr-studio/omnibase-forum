{
    "name": "omnibase/forum",
    "type": "symfony-bundle",
    "description": "Discussion forum for base-bundle: categories, topics built on Thread (tags, followers, likes), markdown posts, moderation and admin CRUD",
    "keywords": [
        "symfony",
        "forum",
        "bbs",
        "discussion"
    ],
    "homepage": "https://gitlab.glitchr.dev/public-repository/symfony/bundle/base/extension/forum",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://gitlab.glitchr.dev/public-repository/agnostic/backup-manager"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.glitchr.dev/public-repository/symfony/bundle/base/component"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.glitchr.dev/public-repository/symfony/bundle/base/extension/admin"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.glitchr.dev/public-repository/symfony/bundle/base/plugin"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.glitchr.dev/public-repository/symfony/bundle/doctrine-dc2type"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.glitchr.dev/public-repository/symfony/bundle/well-known"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.glitchr.dev/public-repository/symfony/bundle/ux/google-api"
        }
    ],
    "autoload": {
        "psr-4": {
            "Base\\Forum\\": "./src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Base\\Forum\\": "./tests"
        }
    },
    "require": {
        "php": "^8.2",
        "doctrine/orm": "^2.15|^3.0",
        "glitchr/omnibase": "3.0.*-dev",
        "omnibase/admin": "dev-main",
        "league/commonmark": "^2.4",
        "symfony/config": "^6.0|^7.0|^8.0",
        "symfony/dependency-injection": "^6.0|^7.0|^8.0",
        "symfony/form": "^6.0|^7.0|^8.0",
        "symfony/http-kernel": "^6.0|^7.0|^8.0",
        "symfony/security-bundle": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "symfony/framework-bundle": "^6.0|^7.0|^8.0",
        "symfony/twig-bundle": "^6.0|^7.0|^8.0",
        "symfony/var-dumper": "^6.0|^7.0|^8.0"
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "XDEBUG_MODE=coverage phpunit --coverage-html var/coverage --coverage-text"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "minimum-stability": "dev",
        "allow-plugins": {
            "glitchr/base-plugin": true,
            "glitchr/doctrine-dc2type": true,
            "php-http/discovery": true
        }
    }
}
